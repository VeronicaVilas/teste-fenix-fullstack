{
    "openapi": "3.0.0",
    "info": {
        "title": "Fênix API",
        "description": "API para gerenciamento de provas online.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api/v1",
            "description": "Fênix API v1"
        }
    ],
    "paths": {
        "/teachers/{teacher}/exams": {
            "post": {
                "tags": [
                    "Exams (Professor)"
                ],
                "summary": "Cria uma prova com questões e alternativas",
                "description": "A prova nasce como rascunho (draft). A posição de questões e alternativas segue a ordem dos arrays.",
                "operationId": "createExam",
                "parameters": [
                    {
                        "name": "teacher",
                        "in": "path",
                        "description": "Id do professor",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/StoreExamRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Prova criada",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Prova criada com sucesso."
                                        },
                                        "status": {
                                            "type": "integer",
                                            "example": 201
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/ExamTeacher"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/UnprocessableEntity"
                    }
                }
            }
        },
        "/up": {
            "get": {
                "tags": [
                    "Health"
                ],
                "summary": "Verifica se a aplicação está no ar",
                "description": "Rota de health check nativa do Laravel, servida fora do prefixo /api/v1.",
                "operationId": "healthCheck",
                "responses": {
                    "200": {
                        "description": "Aplicação disponível"
                    },
                    "500": {
                        "description": "Falha ao inicializar a aplicação"
                    }
                },
                "servers": [
                    {
                        "url": "/",
                        "description": "Raiz da aplicação"
                    }
                ]
            }
        },
        "/teachers": {
            "get": {
                "tags": [
                    "Users"
                ],
                "summary": "Lista os professores",
                "description": "Usado pelo acesso \"Professor\" do frontend. Ordenado por nome.",
                "operationId": "listTeachers",
                "responses": {
                    "200": {
                        "description": "Professores listados",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Professores listados com sucesso."
                                        },
                                        "status": {
                                            "type": "integer",
                                            "example": 200
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/User"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/students": {
            "get": {
                "tags": [
                    "Users"
                ],
                "summary": "Lista os alunos",
                "description": "Usado pelo acesso \"Aluno\" do frontend para escolher qual aluno fará a prova. Ordenado por nome.",
                "operationId": "listStudents",
                "responses": {
                    "200": {
                        "description": "Alunos listados",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Alunos listados com sucesso."
                                        },
                                        "status": {
                                            "type": "integer",
                                            "example": 200
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/User"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "User": {
                "required": [
                    "id",
                    "name",
                    "email"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 2
                    },
                    "name": {
                        "type": "string",
                        "example": "Aluno Fênix"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "student@fenix.local"
                    }
                },
                "type": "object"
            },
            "ErrorResponse": {
                "required": [
                    "message",
                    "status",
                    "errors",
                    "data"
                ],
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Recurso não encontrado."
                    },
                    "status": {
                        "type": "integer",
                        "example": 404
                    },
                    "errors": {
                        "type": "object",
                        "example": []
                    },
                    "data": {
                        "type": "array",
                        "items": {},
                        "example": []
                    }
                },
                "type": "object"
            },
            "ValidationErrorResponse": {
                "required": [
                    "message",
                    "status",
                    "errors",
                    "data"
                ],
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Os dados enviados são inválidos."
                    },
                    "status": {
                        "type": "integer",
                        "example": 422
                    },
                    "errors": {
                        "type": "object",
                        "example": {
                            "title": [
                                "O título é obrigatório."
                            ]
                        },
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "data": {
                        "type": "array",
                        "items": {},
                        "example": []
                    }
                },
                "type": "object"
            },
            "OptionTeacher": {
                "required": [
                    "id",
                    "position",
                    "text",
                    "is_correct"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 2
                    },
                    "position": {
                        "type": "integer",
                        "example": 2
                    },
                    "text": {
                        "type": "string",
                        "example": "Brasília"
                    },
                    "is_correct": {
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            },
            "QuestionTeacher": {
                "required": [
                    "id",
                    "position",
                    "statement",
                    "options"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "position": {
                        "type": "integer",
                        "example": 1
                    },
                    "statement": {
                        "type": "string",
                        "example": "Qual é a capital do Brasil?"
                    },
                    "options": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OptionTeacher"
                        }
                    }
                },
                "type": "object"
            },
            "ExamTeacher": {
                "required": [
                    "id",
                    "title",
                    "status",
                    "questions"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "Prova de Geografia"
                    },
                    "description": {
                        "type": "string",
                        "example": "Capitais e relevo",
                        "nullable": true
                    },
                    "status": {
                        "type": "string",
                        "example": "draft",
                        "enum": [
                            "draft",
                            "published"
                        ]
                    },
                    "published_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": null,
                        "nullable": true
                    },
                    "questions_count": {
                        "type": "integer",
                        "example": 1
                    },
                    "questions": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/QuestionTeacher"
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "StoreExamRequest": {
                "required": [
                    "title",
                    "questions"
                ],
                "properties": {
                    "title": {
                        "type": "string",
                        "example": "Prova de Geografia",
                        "maxLength": 255
                    },
                    "description": {
                        "type": "string",
                        "example": "Capitais e relevo",
                        "nullable": true,
                        "maxLength": 2000
                    },
                    "questions": {
                        "type": "array",
                        "items": {
                            "required": [
                                "statement",
                                "options"
                            ],
                            "properties": {
                                "statement": {
                                    "type": "string",
                                    "example": "Qual é a capital do Brasil?",
                                    "maxLength": 2000
                                },
                                "options": {
                                    "description": "De 2 a 5 alternativas, exatamente uma com is_correct = true. A ordem do array define a posição.",
                                    "type": "array",
                                    "items": {
                                        "required": [
                                            "text",
                                            "is_correct"
                                        ],
                                        "properties": {
                                            "text": {
                                                "type": "string",
                                                "example": "Brasília",
                                                "maxLength": 500
                                            },
                                            "is_correct": {
                                                "type": "boolean",
                                                "example": true
                                            }
                                        },
                                        "type": "object"
                                    },
                                    "maxItems": 5,
                                    "minItems": 2
                                }
                            },
                            "type": "object"
                        },
                        "maxItems": 100,
                        "minItems": 1
                    }
                },
                "type": "object"
            }
        },
        "responses": {
            "NotFound": {
                "description": "Recurso não encontrado",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ErrorResponse"
                        }
                    }
                }
            },
            "UnprocessableEntity": {
                "description": "Dados inválidos",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ValidationErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Exams (Professor)",
            "description": "Exams (Professor)"
        },
        {
            "name": "Health",
            "description": "Health"
        },
        {
            "name": "Users",
            "description": "Users"
        }
    ]
}